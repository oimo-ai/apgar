# Apgar environment for the development stack. Copy to .env and fill the three secrets.
# Generate: openssl rand -hex 32
APGAR_SECRET_KEY=
# Generate: openssl rand -hex 16
APGAR_ADMIN_TOKEN=
# Generate: openssl rand -hex 16
CLICKHOUSE_PASSWORD=
# Anonymous usage telemetry. Set to 0 to disable.
APGAR_TELEMETRY=1
# Public URL of the UI, used in links.
APGAR_PUBLIC_URL=http://localhost:8080
