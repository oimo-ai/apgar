# Apgar environment. Copy to .env and fill the three secrets.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APGAR_SECRET_KEY=
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
APGAR_ADMIN_TOKEN=
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
CLICKHOUSE_PASSWORD=
# Anonymous usage telemetry. Set to 0 to disable.
APGAR_TELEMETRY=1
# Public URL of the UI, used in links.
APGAR_PUBLIC_URL=http://localhost:8080
